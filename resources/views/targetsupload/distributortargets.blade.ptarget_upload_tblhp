/*refine url with  params */
function refineUrl()
{
	//get full url
	var url = window.location.href;
	//get url after/
	//var value = url.substring(url.lastIndexOf('/') + 1);
	//get the part after before ?
	var value  = url.split("?")[0];
	// alert(value);
	return value;
}

function showResponse(data,message)
{

